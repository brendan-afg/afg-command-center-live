{
  "name": "afg-command-center-daily",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "main": "pnpm check && pnpm test && pnpm scan:secrets && node scripts/fetch-github-data.mjs && node scripts/build.mjs && node scripts/verify-artifact.mjs",
